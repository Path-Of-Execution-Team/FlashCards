# =============================================================================
#  Local development stack - copy to .env and edit if a port is taken.
#
#    cp .env.example .env
#    docker compose watch
#
#  Every value here has a default in docker-compose.yml, so the stack runs
#  without a .env at all. .env is gitignored; nothing in it reaches the cluster,
#  where the real secrets come from Vault (see INFRASTRUCTURE.md section 5).
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=flashcards
POSTGRES_USER=flashcards_user
POSTGRES_PASSWORD=changeMeStrong123
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
# Overrides the jwt.secret committed in application.properties. Any value works
# locally; tokens signed with it are not accepted anywhere else.
JWT_SECRET=localDevSecretNotUsedAnywhereElse0123456789abcdef
JWT_EXPIRATION=3600000

# --- Hosted services ---------------------------------------------------------
HOSTED_PORT=8081
APP_KAFKA_DEMO_TOPIC=flashcards-demo-topic

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
METRICS_BUCKETS=50,100,300,1000,2000,3000
# Set to true only if editing a file under src/ stops triggering Fast Refresh -
# some hosts do not deliver inotify events for the files compose syncs in.
WATCHPACK_POLLING=false

# --- Kafka -------------------------------------------------------------------
# Host-side listener. Containers always use kafka:9092; this port exists for
# kafkacat or a consumer started from the IDE.
KAFKA_HOST_PORT=29092
KAFKA_UI_PORT=8085

# --- Mail --------------------------------------------------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Observability -----------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
